{
  "rules": {
    ".read": false,
    ".write": false,
    "skillMatrix": {
      "admins": {
        "$uid": {
          ".read": "auth != null && auth.uid === $uid"
        }
      },
      "teams": {
        ".read": "auth != null && root.child('skillMatrix/admins').child(auth.uid).exists()",
        "$teamId": {
          ".read": "auth != null",
          ".write": "auth != null && (root.child('skillMatrix/admins').child(auth.uid).exists() || (!newData.exists() && (data.child('deletedAt').isNumber() && data.child('deletedAt').val() < now - 7776000000)))",
          ".validate": "$teamId.matches(/^[a-z0-9]{12}$/) && newData.hasChildren(['name', 'createdAt'])",
          "name": {
            ".write": "auth != null && data.exists() && !data.parent().child('deletedAt').exists()",
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 50"
          },
          "createdAt": {
            ".validate": "newData.isNumber() && ((data.exists() && newData.val() === data.val()) || (!data.exists() && newData.val() === now))"
          },
          "deletedAt": {
            ".validate": "newData.isNumber() && newData.val() === now"
          },
          "$other": {
            ".validate": false
          }
        }
      },
      "teamData": {
        ".read": "auth != null && root.child('skillMatrix/admins').child(auth.uid).exists()",
        "$teamId": {
          ".read": "auth != null",
          ".write": "auth != null && !newData.exists() && (root.child('skillMatrix/admins').child(auth.uid).exists() || (root.child('skillMatrix/teams').child($teamId).child('deletedAt').isNumber() && root.child('skillMatrix/teams').child($teamId).child('deletedAt').val() < now - 7776000000) || !root.child('skillMatrix/teams').child($teamId).exists())",
          "skills": {
            "$skillId": {
              ".write": "auth != null && (newData.exists() || root.child('skillMatrix/admins').child(auth.uid).exists() || (data.child('deletedAt').isNumber() && data.child('deletedAt').val() < now - 7776000000))",
              ".validate": "newData.hasChildren(['label', 'refTarget', 'backupTarget', 'order']) && newData.parent().parent().parent().parent().child('teams').child($teamId).exists()",
              "label": {
                ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 60"
              },
              "refTarget": {
                ".validate": "newData.isNumber() && (newData.val() === 0 || newData.val() === 1 || newData.val() === 2 || newData.val() === 3)"
              },
              "backupTarget": {
                ".validate": "newData.isNumber() && (newData.val() === 0 || newData.val() === 1 || newData.val() === 2 || newData.val() === 3)"
              },
              "order": {
                ".validate": "newData.isNumber()"
              },
              "deletedAt": {
                ".validate": "newData.isNumber() && newData.val() === now"
              },
              "$other": {
                ".validate": false
              }
            }
          },
          "members": {
            "$memberId": {
              ".write": "auth != null && (newData.exists() || root.child('skillMatrix/admins').child(auth.uid).exists() || (data.child('deletedAt').isNumber() && data.child('deletedAt').val() < now - 7776000000))",
              ".validate": "newData.hasChildren(['name', 'order']) && newData.parent().parent().parent().parent().child('teams').child($teamId).exists()",
              "name": {
                ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 30"
              },
              "order": {
                ".validate": "newData.isNumber()"
              },
              "deletedAt": {
                ".validate": "newData.isNumber() && newData.val() === now"
              },
              "$other": {
                ".validate": false
              }
            }
          },
          "ratings": {
            ".write": "auth != null && !newData.exists()"
          },
          "scale": {
            ".write": "auth != null && newData.exists()",
            ".validate": "newData.val() === 2"
          },
          "levels": {
            "$memberId": {
              ".write": "auth != null && !newData.exists() && !newData.parent().parent().child('members').child($memberId).exists()",
              "$skillId": {
                ".write": "auth != null",
                ".validate": "newData.isNumber() && (newData.val() === 0 || newData.val() === 1 || newData.val() === 2 || newData.val() === 3) && newData.parent().parent().parent().child('members').child($memberId).exists() && newData.parent().parent().parent().child('skills').child($skillId).exists()"
              }
            }
          },
          "noProgress": {
            "$memberId": {
              ".write": "auth != null && !newData.exists() && !newData.parent().parent().child('members').child($memberId).exists()",
              "$skillId": {
                ".write": "auth != null",
                ".validate": "newData.val() === true && newData.parent().parent().parent().child('members').child($memberId).exists() && newData.parent().parent().parent().child('skills').child($skillId).exists()"
              }
            }
          },
          "$other": {
            ".validate": false
          }
        }
      },
      "$other": {
        ".validate": false
      }
    }
  }
}
